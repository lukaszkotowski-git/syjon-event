generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FormStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SubmissionStatus {
  RESERVED
  // Wpłacona zaliczka — miejsce zajęte na stałe, bilet QR dopiero po dopłacie reszty.
  DEPOSIT_PAID
  PAID
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  NEW
  PENDING
  CONFIRMED
  REJECTED
  ERROR
  ABANDONED
  EXPIRED
}

// FULL — cała kwota naraz; DEPOSIT — zaliczka; BALANCE — dopłata reszty po zaliczce.
enum PaymentKind {
  FULL
  DEPOSIT
  BALANCE
}

enum DiscountType {
  PERCENT
  AMOUNT
}

enum CheckInResult {
  SUCCESS
  DUPLICATE
  INVALID
  EXPIRED
}

enum CheckInMethod {
  QR
  MANUAL
}

// ADMIN — pełny dostęp; VIEWER — tylko podgląd (np. wolontariusze przy wejściu).
enum AdminRole {
  ADMIN
  VIEWER
}

model Admin {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         AdminRole @default(ADMIN)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  disabledAt   DateTime? @map("disabled_at") @db.Timestamptz(3)

  sessions      Session[]
  createdForms  Form[]    @relation("FormCreatedBy")
  auditLogs     AuditLog[]
  messages      FormMessage[]

  @@map("admins")
}

model Session {
  idHash     String    @id @map("id_hash")
  adminId    String    @map("admin_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
  @@map("sessions")
}

model Form {
  id                        String     @id @default(uuid()) @db.Uuid
  slug                      String     @unique
  title                     String
  description               String?
  status                    FormStatus @default(DRAFT)
  schemaJson                Json       @default("{\"fields\":[]}") @map("schema_json")
  capacityTotal             Int?       @map("capacity_total")
  eventDate                 DateTime   @map("event_date") @db.Timestamptz(3)
  // Miejsce wydarzenia (adres lub nazwa) — trafia na stronę, do e-maila i pliku kalendarza.
  location                  String?
  closesAt                  DateTime   @map("closes_at") @db.Timestamptz(3)
  termsVersion              String     @default("1.0") @map("terms_version")
  privacyPolicyVersion      String     @default("1.0") @map("privacy_policy_version")
  // Treści strony powrotu z płatności. NULL = tekst domyślny aplikacji.
  paymentSuccessTitle       String?    @map("payment_success_title")
  paymentSuccessBody        String?    @map("payment_success_body")
  paymentErrorTitle         String?    @map("payment_error_title")
  paymentErrorBody          String?    @map("payment_error_body")
  confirmationEmailTitle    String?    @map("confirmation_email_title")
  confirmationEmailBody     String?    @map("confirmation_email_body")
  // Termin dopłaty reszty dla zgłoszeń opłaconych zaliczką. Wymagany, gdy któryś bilet ma zaliczkę.
  balanceDueAt              DateTime?  @map("balance_due_at") @db.Timestamptz(3)
  // Treść e-maila po wpłacie zaliczki. NULL = tekst domyślny aplikacji.
  depositEmailTitle         String?    @map("deposit_email_title")
  depositEmailBody          String?    @map("deposit_email_body")
  backgroundImageDesktopUrl String?    @map("background_image_desktop_url")
  backgroundImageMobileUrl  String?    @map("background_image_mobile_url")
  createdAt                 DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt                DateTime?  @map("archived_at") @db.Timestamptz(3)
  // Konto administratora usunięte po utworzeniu wydarzenia nie może zablokować wydarzenia — stąd SetNull.
  createdByAdminId          String?    @map("created_by_admin_id") @db.Uuid

  createdByAdmin  Admin?           @relation("FormCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  ticketTypes     TicketType[]
  submissions     Submission[]
  discountCodes   DiscountCode[]
  scanStations    ScanStation[]
  checkInAttempts CheckInAttempt[]
  messages        FormMessage[]

  @@index([status])
  @@map("forms")
}

model TicketType {
  id         String   @id @default(uuid()) @db.Uuid
  formId     String   @map("form_id") @db.Uuid
  name       String
  priceCents Int      @map("price_cents")
  // Kwota zaliczki; NULL = bilet płatny tylko w całości.
  depositCents Int?   @map("deposit_cents")
  currency   String   @default("PLN") @db.Char(3)
  capacity   Int?
  sortOrder  Int      @default(0) @map("sort_order")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  form        Form         @relation(fields: [formId], references: [id], onDelete: Restrict)
  submissions Submission[]

  @@index([formId])
  @@map("ticket_types")
}

model DiscountCode {
  id        String       @id @default(uuid()) @db.Uuid
  formId    String       @map("form_id") @db.Uuid
  code      String
  type      DiscountType
  value     Int
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  form        Form         @relation(fields: [formId], references: [id], onDelete: Restrict)
  submissions Submission[]

  @@unique([formId, code])
  @@index([formId])
  @@map("discount_codes")
}

model Submission {
  id                           String           @id @default(uuid()) @db.Uuid
  formId                       String           @map("form_id") @db.Uuid
  ticketTypeId                 String           @map("ticket_type_id") @db.Uuid
  ticketNameSnapshot           String           @map("ticket_name_snapshot")
  ticketPriceCents             Int              @map("ticket_price_cents")
  currency                     String           @default("PLN") @db.Char(3)
  discountCodeId               String?          @map("discount_code_id") @db.Uuid
  discountCodeSnapshot         String?          @map("discount_code_snapshot")
  discountAmountCents          Int              @default(0) @map("discount_amount_cents")
  // Zaliczka wybrana przy rejestracji (NULL = płatność w całości). ticket_price_cents to zawsze pełna kwota.
  depositCents                 Int?             @map("deposit_cents")
  // Suma faktycznie wpłaconych kwot (Paynow i wpłaty odnotowane ręcznie przez admina).
  paidCents                    Int              @default(0) @map("paid_cents")
  buyerEmail                   String           @map("buyer_email")
  buyerPhone                   String?          @map("buyer_phone")
  buyerAddress                 String?          @map("buyer_address")
  payloadJson                  Json             @map("payload_json")
  schemaSnapshotJson           Json             @map("schema_snapshot_json")
  termsVersionAccepted         String           @map("terms_version_accepted")
  privacyPolicyVersionAccepted String           @map("privacy_policy_version_accepted")
  legalAcceptedAt              DateTime         @map("legal_accepted_at") @db.Timestamptz(3)
  // Zgody dodatkowe z formularza: [{ key, label, accepted }] — snapshot treści w chwili zgłoszenia.
  consentsJson                 Json             @default("[]") @map("consents_json")
  status                       SubmissionStatus @map("status")
  reservationExpiresAt         DateTime?        @map("reservation_expires_at") @db.Timestamptz(3)
  publicTokenHash              String           @unique @map("public_token_hash")
  // Drugi token dostępu — do linku dopłaty w e-mailu wysyłanym z webhooka, gdy jawny publicToken już nie istnieje.
  emailTokenHash               String?          @unique @map("email_token_hash")
  depositEmailSentAt           DateTime?        @map("deposit_email_sent_at") @db.Timestamptz(3)
  confirmationEmailSentAt      DateTime?        @map("confirmation_email_sent_at") @db.Timestamptz(3)
  // Nonce kodu QR biletu (w QR jest podpisany HMAC-iem razem z id). NULL = bilet jeszcze nie wystawiony;
  // nowy nonce unieważnia poprzedni QR.
  ticketNonce                  String?          @map("ticket_nonce")
  ticketIssuedAt               DateTime?        @map("ticket_issued_at") @db.Timestamptz(3)
  checkedInAt                  DateTime?        @map("checked_in_at") @db.Timestamptz(3)
  checkedInStationId           String?          @map("checked_in_station_id") @db.Uuid
  createdAt                    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  form             Form             @relation(fields: [formId], references: [id], onDelete: Restrict)
  ticketType       TicketType       @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  discountCode     DiscountCode?    @relation(fields: [discountCodeId], references: [id], onDelete: Restrict)
  checkedInStation ScanStation?     @relation(fields: [checkedInStationId], references: [id], onDelete: Restrict)
  payments         Payment[]
  checkInAttempts  CheckInAttempt[]

  @@index([formId, status])
  @@index([ticketTypeId, status])
  @@index([reservationExpiresAt])
  @@index([buyerEmail])
  @@index([formId, checkedInAt])
  @@map("submissions")
}

// Stanowisko skanujące przypisane do jednego wydarzenia — tożsamość operatora w audycie.
model ScanStation {
  id             String    @id @default(uuid()) @db.Uuid
  formId         String    @map("form_id") @db.Uuid
  name           String
  // Losowy token z QR logowania — sam nie wystarcza do wejścia, potrzebny jest też PIN.
  loginToken     String    @unique @map("login_token")
  pinHash        String    @map("pin_hash")
  failedPinCount Int       @default(0) @map("failed_pin_count")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz(3)
  isActive       Boolean   @default(true) @map("is_active")
  lastSeenAt     DateTime? @map("last_seen_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  form      Form             @relation(fields: [formId], references: [id], onDelete: Restrict)
  sessions  StationSession[]
  attempts  CheckInAttempt[]
  checkedIn Submission[]

  @@index([formId])
  @@map("scan_stations")
}

model StationSession {
  idHash    String    @id @map("id_hash")
  stationId String    @map("station_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  station ScanStation @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@index([stationId])
  @@map("station_sessions")
}

// Każda próba zameldowania — także nieudana — do wyjaśniania sporów na wejściu.
model CheckInAttempt {
  id           String        @id @default(uuid()) @db.Uuid
  formId       String        @map("form_id") @db.Uuid
  stationId    String        @map("station_id") @db.Uuid
  submissionId String?       @map("submission_id") @db.Uuid
  method       CheckInMethod
  result       CheckInResult
  // Szczegół wyniku, np. WRONG_EVENT, REISSUED, NOT_PAID, BAD_SIGNATURE.
  reason       String?
  // Skrót zeskanowanej treści — pozwala powiązać powtarzające się próby bez przechowywania samego kodu.
  codeHash     String?       @map("code_hash")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  form       Form        @relation(fields: [formId], references: [id], onDelete: Restrict)
  station    ScanStation @relation(fields: [stationId], references: [id], onDelete: Restrict)
  submission Submission? @relation(fields: [submissionId], references: [id], onDelete: Restrict)

  @@index([formId, createdAt(sort: Desc)])
  @@index([stationId, createdAt(sort: Desc)])
  @@index([submissionId])
  @@map("check_in_attempts")
}

model Payment {
  id                  String        @id @default(uuid()) @db.Uuid
  submissionId        String        @map("submission_id") @db.Uuid
  // "paynow" albo "manual" — wpłata odnotowana ręcznie przez admina (gotówka, przelew).
  provider            String        @default("paynow")
  kind                PaymentKind   @default(FULL)
  providerPaymentId   String?       @unique @map("provider_payment_id")
  idempotencyKey      String        @unique @map("idempotency_key")
  amountCents         Int           @map("amount_cents")
  currency            String        @default("PLN") @db.Char(3)
  status              PaymentStatus @default(NEW)
  providerModifiedAt  DateTime?     @map("provider_modified_at") @db.Timestamptz(3)
  redirectUrl         String?       @map("redirect_url")
  providerPayloadJson Json?         @map("provider_payload_json")
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Restrict)

  @@index([submissionId, createdAt(sort: Desc)])
  @@index([status])
  @@map("payments")
}

// Kto, co i kiedy zmienił w panelu — do wyjaśniania zmian w wydarzeniach i zgłoszeniach.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  adminId    String?  @map("admin_id") @db.Uuid
  // Snapshot e-maila — wpis zostaje czytelny także po usunięciu konta.
  adminEmail String   @map("admin_email")
  action     String
  formId     String?  @map("form_id") @db.Uuid
  entityId   String?  @map("entity_id")
  summary    String
  detailsJson Json?   @map("details_json")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  admin Admin? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([formId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// Wiadomość wysłana przez organizatora do uczestników wydarzenia.
model FormMessage {
  id             String    @id @default(uuid()) @db.Uuid
  formId         String    @map("form_id") @db.Uuid
  adminId        String?   @map("admin_id") @db.Uuid
  subject        String
  body           String
  // Filtr odbiorców: { statuses: [...], ticketTypeIds: [...] }.
  audienceJson   Json      @map("audience_json")
  recipientCount Int       @map("recipient_count")
  sentCount      Int       @default(0) @map("sent_count")
  failedCount    Int       @default(0) @map("failed_count")
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  form  Form   @relation(fields: [formId], references: [id], onDelete: Cascade)
  admin Admin? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([formId, createdAt(sort: Desc)])
  @@map("form_messages")
}
