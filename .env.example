# ---- aplikacja ----
NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ---- baza ----
DATABASE_URL=postgresql://syjonevent:syjonevent@localhost:5432/syjonevent
POSTGRES_USER=syjonevent
POSTGRES_PASSWORD=zmien-mnie
POSTGRES_DB=syjonevent

# ---- sesje ----
# min. 32 znaki, wygeneruj: openssl rand -base64 48
SESSION_SECRET=zmien-mnie-na-losowy-ciag-minimum-32-znaki
SESSION_TTL_HOURS=12

# ---- konta administratorów (seed) ----
# format: email:haslo,email2:haslo2 — hasło min. 12 znaków, bez przecinków
ADMIN_USERS=admin1@example.com:HasloAdmina123,admin2@example.com:HasloAdmina456

# ---- Paynow ----
PAYNOW_ENV=sandbox
PAYNOW_API_KEY=
PAYNOW_SIGNATURE_KEY=
# TTL rezerwacji = validityTime w Paynow (sekundy, 60..864000)
PAYNOW_VALIDITY_SECONDS=900

# ---- e-mail (SMTP, potwierdzenia rejestracji/zakupu) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=syjonevents@gmail.com
SMTP_PASSWORD=
MAIL_FROM="Syjon Event <syjonevents@gmail.com>"
